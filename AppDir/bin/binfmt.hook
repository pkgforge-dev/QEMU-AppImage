#!/bin/sh

# Registering a binfmt_misc handler is a global root-only kernel operation, so
# an AppImage can never do it on its own. What can be bundled are the static
# interpreters, so that this does not need the host package
# qemu-user-static-binfmt, plus a fixed install path because the AppImage mount
# point changes on every run and the handlers pin the interpreter path.
#
# The rules are written to /usr/local/lib/binfmt.d so that
# systemd-binfmt.service re-registers them on every boot.

_qemu_binfmt_dir=/usr/local/libexec/qemu-binfmt
_qemu_binfmt_confdir=/usr/local/lib/binfmt.d

_qemu_binfmt_entries() {
	for c in "$APPDIR"/lib/binfmt.d/*.conf; do
		[ -f "$c" ] || continue
		IFS=: read -r _ name _type _offset _magic _mask _interp _flags < "$c" || :
		[ -n "$name" ] || continue
		# qemu-user and qemu-user-static ship confs with the same magic
		[ -f "$APPDIR"/shared/bin/"$name"-static ] || continue
		case " $_qemu_binfmt_seen " in
			*" $name "*) continue;;
		esac
		_qemu_binfmt_seen="$_qemu_binfmt_seen $name"
		printf ':%s:%s:%s:%s:%s:%s:%s\n' \
			"$name" "$_type" "$_offset" "$_magic" "$_mask" \
			"$_qemu_binfmt_dir/$name-static" "$_flags"
	done
}

_qemu_binfmt_run() {
	[ -n "$APPDIR" ] || return 0

	_stage=${TMPDIR:-/tmp}/.qemu-binfmt-$$
	mkdir -p "$_stage"
	_qemu_binfmt_seen=""
	_qemu_binfmt_entries > "$_stage"/entries

	if [ ! -s "$_stage"/entries ]; then
		rm -rf "$_stage"
		err_msg "This build ships no static qemu-user interpreters."
		err_msg "Transparent emulation of foreign binaries needs a binfmt"
		err_msg "handler, install the host package qemu-user-static-binfmt"
		err_msg "or run them explicitly: '$ARG0 qemu-aarch64 ./program'."
		return 0
	fi

	cut -d: -f2 "$_stage"/entries > "$_stage"/names

	if [ "$1" = remove ]; then
		cat > "$_stage"/run.sh <<-EOF
		#!/bin/sh
		while IFS= read -r name; do
		        rm -f "$_qemu_binfmt_confdir"/"\$name".conf
		        echo -1 > /proc/sys/fs/binfmt_misc/"\$name" 2>/dev/null || :
		done < "$_stage"/names
		rm -rf $_qemu_binfmt_dir
		command -v systemctl >/dev/null && systemctl restart systemd-binfmt.service || :
		exit 0
		EOF
	else
		cat > "$_stage"/run.sh <<-EOF
		#!/bin/sh
		set -e
		mkdir -p $_qemu_binfmt_dir $_qemu_binfmt_confdir
		cp -f "$APPDIR"/shared/bin/qemu-*-static $_qemu_binfmt_dir/
		chmod a+rX $_qemu_binfmt_dir $_qemu_binfmt_dir/qemu-*-static
		while IFS= read -r line; do
		        name=\${line#:}
		        name=\${name%%:*}
		        printf '%s\n' "\$line" > "$_qemu_binfmt_confdir"/"\$name".conf
		        echo -1 > /proc/sys/fs/binfmt_misc/"\$name" 2>/dev/null || :
		done < "$_stage"/entries
		if command -v systemctl >/dev/null; then
		        systemctl restart systemd-binfmt.service
		else
		        if [ ! -e /proc/sys/fs/binfmt_misc/register ]; then
		                mount -t binfmt_misc binfmt_misc /proc/sys/fs/binfmt_misc
		        fi
		        while IFS= read -r line; do
		                printf '%s\n' "\$line" \
		                        > /proc/sys/fs/binfmt_misc/register
		        done < "$_stage"/entries
		fi
		EOF
	fi

	if run_gui_sudo /bin/sh "$_stage"/run.sh; then
		if [ "$1" = remove ]; then
			notify --notify-info "qemu-user binfmt handlers removed"
		else
			notify --notify-info "qemu-user binfmt handlers installed"
		fi
	else
		err_msg "Could not $1 the qemu-user binfmt handlers"
	fi
	rm -rf "$_stage"
}

case "$1" in
	--make-binfmt)   _qemu_binfmt_run install; exit 0;;
	--remove-binfmt) _qemu_binfmt_run remove;  exit 0;;
esac
